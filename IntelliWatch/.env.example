# ==============================================================================
# IntelliWatch Environment Configuration Template
# ==============================================================================
# Copy this file to .env and adjust variables as needed.
# NEVER commit .env with real secrets to version control.

# Application Information
PROJECT_NAME="IntelliWatch"
VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=true

# API Server Settings
API_HOST="0.0.0.0"
API_PORT=8000

# Logging Configuration
LOG_LEVEL="INFO"
LOG_FILE="logs/intelliwatch.log"

# Vision / Computer Vision Pipeline Settings
MODEL_PATH="weights/yolov8n.pt"
CONFIDENCE_THRESHOLD=0.50
IOU_THRESHOLD=0.45
VIDEO_SOURCE="0"
OUTPUT_DIR="data/output"
FPS_SETTINGS=30

# Database Configuration (Planned for future steps)
# DATABASE_URL="postgresql+asyncpg://user:password@localhost:5432/intelliwatch"
